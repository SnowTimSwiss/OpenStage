{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStage",
  "version": "2.0.0",
  "identifier": "dev.openstage.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenStage",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; connect-src 'self' https://accounts.spotify.com https://api.spotify.com https://api.github.com https://raw.githubusercontent.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/libreoffice/": "libreoffice/"
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      },
      "allowDowngrades": true
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
